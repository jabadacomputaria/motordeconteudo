  "lines": [
    {
      "text": "Você pediu: faz um vídeo pra minha empresa.",
      "start": 0.06,
      "beat": 0
    },
    {
      "text": "A IA entregou frase pronta e foto genérica.",
      "start": 2.96,
      "beat": 6
    },
    {
      "text": "Igual ao vídeo do seu concorrente.",
      "start": 6.05,
      "beat": 13
    },
    {
      "text": "E ninguém parou de rolar.",
      "start": 8.21,
      "beat": 17
    },
    {
      "text": "Aí a culpa foi pra IA...",
      "start": 9.96,
      "beat": 21
    },
    {
      "text": "Não falta IA... falta direção.",
      "start": 11.88,
      "beat": 25
    },
    {
      "text": "Ela faz exatamente o que você descreve.",
      "start": 15.07,
      "beat": 32
    },
    {
      "text": "Pedido vago, vídeo vago.",
      "start": 17.78,
      "beat": 38
    },
    {
      "text": "Então o pedido ganha o público e a dor.",
      "start": 19.91,
      "beat": 42
    },
    {
      "text": "Depois, o que aparece na tela em cada frase.",
      "start": 22.57,
      "beat": 48
    },
    {
      "text": "Aí entram a voz e o ritmo.",
      "start": 25.63,
      "beat": 54
    },
    {
      "text": "A IA escreve, anima e encaixa tudo na voz.",
      "start": 27.95,
      "beat": 59
    },
    {
      "text": "Esse vídeo aqui saiu de um pedido assim.",
      "start": 31.55,
      "beat": 67
    },
    {
      "text": "E quem dirige o pedido sai na frente.",
      "start": 33.88,
      "beat": 72
    },
    {
      "text": "Sem fórmula mágica.",
      "start": 36.27,
      "beat": 77
    },
    {
      "text": "Direção antes do clique.",
      "start": 37.79,
      "beat": 80
    }
  ],
